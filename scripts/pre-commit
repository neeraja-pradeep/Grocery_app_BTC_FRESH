#!/usr/bin/env bash
RED="\033[0;31m"; GREEN="\033[0;32m"; YELLOW="\033[1;33m"; BLUE="\033[0;34m"; NC="\033[0m"
ok(){ echo -e "${GREEN}✔ $1${NC}"; }
err(){ echo -e "${RED}✖ $1${NC}"; }
warn(){ echo -e "${YELLOW}! $1${NC}"; }
header(){ echo -e "\n${BLUE}��� $1${NC}"; }

header "Running grocery_app Pre-commit Checks"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
DART_FILES=$(echo "$STAGED_FILES" | grep '\.dart$' || true)

if [ -z "$STAGED_FILES" ]; then
  warn "No files staged for commit."
  exit 0
fi

# 1️⃣ Dart Formatting
header "Formatting Dart files"
if [ -n "$DART_FILES" ]; then
  FORMAT_FAIL=false
  for f in $DART_FILES; do
    if [ -f "$f" ]; then
      echo " → Formatting $f"
      dart format --set-exit-if-changed "$f" >/dev/null 2>&1
      if [ $? -ne 0 ]; then
        echo "   ⚠ Failed to format: $f"
        FORMAT_FAIL=true
      else
        git add "$f"
      fi
    fi
  done
  if [ "$FORMAT_FAIL" = true ]; then
    err "Formatting failed. Run: dart format ."
    exit 1
  fi
  ok "All Dart files formatted successfully"
else
  warn "No Dart files found to format"
fi

# 2️⃣ Analyzer
header "Running flutter analyze"
flutter analyze >/dev/null 2>&1 || { err "Analyzer found issues. Run: flutter analyze"; exit 1; }
ok "Analyzer passed"

# 3️⃣ custom_lint
header "Running custom_lint"
dart run custom_lint >/dev/null 2>&1 || { err "custom_lint found issues. Run: dart run custom_lint"; exit 1; }
ok "custom_lint passed"

# 4️⃣ Debug Prints
header "Checking for print()/debugPrint()"
DEBUG_FOUND=false
for f in $DART_FILES; do
  if grep -E "print\(|debugPrint\(" "$f" | grep -v "^[[:space:]]*//" >/dev/null 2>&1; then
    echo " ⚠ Found debug print in: $f"
    DEBUG_FOUND=true
  fi
done
if [ "$DEBUG_FOUND" = true ]; then err "Remove print()/debugPrint() before committing"; exit 1; fi
ok "No debug prints found"

# ✅ Success
header "✅ All Checks Passed"
ok "Proceeding with commit..."
exit 0
