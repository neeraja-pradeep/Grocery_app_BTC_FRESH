#!/usr/bin/env bash
# ============================================
# grocery_app pre-commit hook (Windows + Flutter)
# ============================================

# --- Flutter & Dart PATH setup (adjust if needed) ---
export PATH="$PATH:/c/Users/anjel/flutter/bin:/c/Users/anjel/flutter/bin/cache/dart-sdk/bin"

RED="\033[0;31m"; GREEN="\033[0;32m"; YELLOW="\033[1;33m"; BLUE="\033[0;34m"; NC="\033[0m"
ok(){ echo -e "${GREEN}✔ $1${NC}"; }
err(){ echo -e "${RED}✖ $1${NC}"; }
warn(){ echo -e "${YELLOW}! $1${NC}"; }
header(){ echo -e "\n${BLUE}🚀 $1${NC}"; }

header "Running grocery_app Pre-commit Checks"

# ----------------------------------------------------
# 1️⃣ Gather staged files
# ----------------------------------------------------
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED_FILES" ]; then
  warn "No files staged for commit."
  exit 0
fi

# ----------------------------------------------------
# 2️⃣ Format Dart files
# ----------------------------------------------------
header "Formatting Dart files"
DART_FILES=$(echo "$STAGED_FILES" | grep '\.dart$' || true)

if [ -n "$DART_FILES" ]; then
  echo "Ensuring UTF-8 encoding & formatting Dart files..."
  for f in $DART_FILES; do
    flutter format "$f" >/dev/null 2>&1 || {
      err "Formatting failed for $f. Run 'flutter format .'"
      exit 1
    }
    git add "$f"
  done
  ok "Formatted & re-staged all Dart files"
else
  warn "No Dart files found to format"
fi

# ----------------------------------------------------
# 3️⃣ Flutter analyze
# ----------------------------------------------------
header "Running flutter analyze"
flutter analyze >/dev/null 2>&1 || {
  err "Analyzer found issues. Run 'flutter analyze' manually."
  exit 1
}
ok "Analyzer passed"

# ----------------------------------------------------
# 4️⃣ custom_lint
# ----------------------------------------------------
header "Running custom_lint"
dart run custom_lint >/dev/null 2>&1 || {
  err "custom_lint found issues"
  exit 1
}
ok "custom_lint passed"

# ----------------------------------------------------
# 5️⃣ Check for print() or debugPrint()
# ----------------------------------------------------
header "Checking for debug prints / TODOs"
DEBUG_FOUND=false
for f in $DART_FILES; do
  if grep -E "print\(|debugPrint\(" "$f" | grep -v "^[[:space:]]*//" >/dev/null 2>&1; then
    echo " ⚠ $f"
    DEBUG_FOUND=true
  fi
done

if [ "$DEBUG_FOUND" = true ]; then
  err "Remove print()/debugPrint() before committing."
  exit 1
fi
ok "No debug prints found"

# ----------------------------------------------------
# ✅ All checks passed
# ----------------------------------------------------
header "✅ All Checks Passed"
ok "Proceeding with commit..."
exit 0
